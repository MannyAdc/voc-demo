#!/bin/sh
# Test gate for merge commits (git runs pre-merge-commit, not pre-commit, for a merge):
# gitleaks, the names check and the tests, on exactly what will be committed.
# Install once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
for py in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python"; do
  if [ -x "$py" ]; then
    exec "$py" "$root/.claude/hooks/test_gate.py" --git-pre-commit
  fi
done
echo "pre-commit: no project Python in .venv, run uv sync" >&2
exit 1
