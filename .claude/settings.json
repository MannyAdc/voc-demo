{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git branch -D*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(gh pr merge*)"
    ],
    "ask": [
      "Bash(*voc ledger init*)",
      "Bash(*voc ledger raise*)",
      "Bash(*voc ledger release*)",
      "Bash(*voc ledger clear-overrun*)",
      "PowerShell(*voc ledger init*)",
      "PowerShell(*voc ledger raise*)",
      "PowerShell(*voc ledger release*)",
      "PowerShell(*voc ledger clear-overrun*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" read_guard.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_gate.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" data_guard.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
