{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git branch -D*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(gh pr merge*)",
      "mcp__claude-in-chrome__*",
      "mcp__chrome-devtools__*",
      "mcp__Claude_Browser__*",
      "mcp__remote-devices__*",
      "mcp__computer-use__*",
      "enable__mcp__claude-in-chrome",
      "enable__mcp__remote-devices__Claude_Browser",
      "enable__mcp__remote-devices__computer",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:*.cloud.databricks.com)",
      "WebFetch(domain:*.azuredatabricks.net)"
    ],
    "ask": [
      "Bash(*voc ledger init*)",
      "Bash(*voc ledger raise*)",
      "Bash(*voc ledger release*)",
      "Bash(*voc ledger clear-overrun*)",
      "PowerShell(*voc ledger init*)",
      "PowerShell(*voc ledger raise*)",
      "PowerShell(*voc ledger release*)",
      "PowerShell(*voc ledger clear-overrun*)",
      "Bash(*voc.exe ledger init*)",
      "Bash(*voc.exe ledger raise*)",
      "Bash(*voc.exe ledger release*)",
      "Bash(*voc.exe ledger clear-overrun*)",
      "PowerShell(*voc.exe ledger init*)",
      "PowerShell(*voc.exe ledger raise*)",
      "PowerShell(*voc.exe ledger release*)",
      "PowerShell(*voc.exe ledger clear-overrun*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" read_guard.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" test_gate.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" data_guard.py || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
