# Python
__pycache__/
.pytest_cache/
.venv/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Raw data and anything derived from it stays out of git
/data/
*.csv
*.zip
*.parquet
*.jsonl
*.duckdb
*.duckdb.wal
/recordings/
ledger.json

# Small synthetic fixtures are committed (synthetic IDs start with SYN-).
# dbt seeds are never committed (T021), with one exception by owner decision of 5 November (spec 004): the
# test list seed, a byte copy of splits/test.csv (IDs and hashes only), which a test keeps identical, so a job
# that runs dbt from a Git checkout needs no write into it.
!dbt/seeds/test_list.csv
!tests/fixtures/**/*.csv
!results/*.jsonl
# Labelling results hold IDs, labels, quote positions and token counts, never complaint text
!results/labels/*.csv
# Evaluation results add the TF-IDF label and confidence, never complaint text
!results/eval/*.csv
# Review decisions hold IDs, labels and a reason from a fixed list, never complaint text (A12)
!results/reviews/*.csv
# Validation results hold IDs, labels, positions, codes and counts, never complaint text (spec 003, V8).
# Only the planned files: any other CSV there stays ignored.
!results/validation/v1_consistency_r*.csv
!results/validation/v*_codes.csv
!results/validation/v5_judge.csv
!splits/**
!config/**
!tests/fixtures/**/*.jsonl

# Local names deny list for the names check, never committed
.names-denylist

# dbt build output
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Node
node_modules/
web/dist/

# Claude Code local settings
.claude/settings.local.json

# Personal editor settings
.vscode/

# Worktrees made for parallel agents
.claude/worktrees/
