# Python
__pycache__/
.pytest_cache/
.venv/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Raw data and anything derived from it stays out of git
/data/
*.csv
*.zip
*.parquet
*.jsonl
*.duckdb
*.duckdb.wal
recordings/
ledger.json

# Small synthetic fixtures and dbt seeds are committed (synthetic IDs start with SYN-)
!tests/fixtures/**/*.csv
!dbt/seeds/*.csv
!results/*.jsonl
!tests/fixtures/**/*.jsonl

# Local names deny list for the names check, never committed
.names-denylist

# dbt build output
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Node
node_modules/
web/dist/

# Claude Code local settings
.claude/settings.local.json
